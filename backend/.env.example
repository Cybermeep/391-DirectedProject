# Copy to backend/.env. All of these have safe defaults (see appconfig.py)
# except GOOGLE_CLIENT_ID, which must be set for Google sign-in to work.

# --- Server ---
NIDS_API_HOST=127.0.0.1
NIDS_API_PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API (your deployed
# website's origin, plus http://localhost:5173 for local dev).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Secrets ---
# Leave blank to auto-generate and persist one under the app data
# directory on first run (see appconfig._get_or_create_secret). Set
# explicitly for a deployed/shared backend so restarts don't invalidate
# every session.
SECRET_KEY=
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# --- Google Sign-In ---
# OAuth 2.0 Client ID from Google Cloud Console. Must match the frontend's
# VITE_GOOGLE_CLIENT_ID (same value, both client-facing).
GOOGLE_CLIENT_ID=

# --- Data directory override ---
# By default the app resolves an OS-appropriate per-user data directory
# (see appconfig.py). Set this to pin it somewhere specific instead
# (e.g. a Docker volume mount).
# NIDS_DATA_DIR=/data/nids
