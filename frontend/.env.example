# Copy this file to .env (Electron dev) or configure these as build-time
# environment variables in your static host (Vercel/Netlify/etc.) for the
# website deployment. Vite only exposes vars prefixed with VITE_.

# Base URL of the Flask API. For local dev/Electron this is the bundled
# backend; for a deployed website, point this at your deployed backend.
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL (no /api suffix) used for the Socket.IO real-time connection.
# If omitted, it's derived from VITE_API_BASE_URL automatically.
VITE_WS_URL=http://localhost:5000

# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application).
# Add both http://localhost:5173 and your deployed site's origin under
# "Authorized JavaScript origins". Leave blank to disable the Google
# sign-in button entirely.
VITE_GOOGLE_CLIENT_ID=

# Public URL to a zip archive of the trained model files (random_forest.joblib,
# preprocessor_*.joblib, evaluation_metrics.json), e.g. a public GitHub Release
# asset. When set, the packaged Electron app downloads and installs the model
# itself on first launch, showing a progress window - no manual installer
# step needed. Leave blank to skip auto-download (falls back to running
# installer/setup_wizard.py --model-dir/--model-url manually).
MAIN_VITE_NIDS_MODEL_URL=
